// Cloudflare Workers config. `npx wrangler deploy` builds the site first (build.command),
// so it works whatever build command the Cloudflare dashboard has.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "va-energy-watch",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Required by `wrangler preview`, which Workers Builds runs for pull-request branches.
  "previews": {}
}

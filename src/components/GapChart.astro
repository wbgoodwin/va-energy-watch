---
import raw from "../data/prices/generation_vs_price.json";
import pricesRaw from "../data/prices/residential_prices.json";
import { scale, ticks, type ResidentialPrices } from "../lib/prices.ts";
import { avg, gapRows, mixGroups, type GenerationVsPrice } from "../lib/gap.ts";

// Retail price vs. wholesale cost of power vs. Virginia fleet running cost, one axis (cents per kWh).
const d = raw as unknown as GenerationVsPrice;
const prices = pricesRaw as unknown as ResidentialPrices;
const rows = gapRows(d, prices);
const y0 = rows[0].year, y1 = rows[rows.length - 1].year;
const W = 760, H = 360, M = { t: 16, r: 150, b: 34, l: 44 };
const x = scale(y0, y1, M.l, W - M.r);
const yMax = 20;
const y = scale(0, yMax, H - M.b, M.t);
const yt = ticks(0, yMax, 4);
const xt = ticks(y0, y1, 5).filter((v) => v >= y0 && v <= y1);

// Contiguous runs of years with wholesale data (2014 is left out).
const runs: (typeof rows)[] = [];
for (const r of rows) {
  if (r.generation === null) { runs.push([]); continue; }
  if (!runs.length) runs.push([]);
  runs[runs.length - 1].push(r);
}
const area = (run: typeof rows, lo: (r: (typeof rows)[number]) => number, hi: (r: (typeof rows)[number]) => number) =>
  run.length < 2 ? "" :
  "M" + run.map((r) => `${x(r.year).toFixed(1)},${y(hi(r)).toFixed(1)}`).join("L") +
  "L" + [...run].reverse().map((r) => `${x(r.year).toFixed(1)},${y(lo(r)).toFixed(1)}`).join("L") + "Z";
const gen = (r: (typeof rows)[number]) => r.generation ?? 0;
const grid = (r: (typeof rows)[number]) => (r.generation ?? 0) + (r.grid ?? 0);
const line = (pts: { year: number; v: number | null }[]) =>
  pts.filter((p) => p.v !== null).map((p, i) => `${i ? "L" : "M"}${x(p.year).toFixed(1)},${y(p.v!).toFixed(1)}`).join("");
const retailPath = line(rows.map((r) => ({ year: r.year, v: r.retail })));
const fleetPts = rows.filter((r) => r.fleet !== null);
const fleetPath = line(fleetPts.map((r) => ({ year: r.year, v: r.fleet })));
const lastFull = rows.filter((r) => !r.partial).at(-1)!;
const partial = rows.find((r) => r.partial);

const early = rows.filter((r) => r.year >= 2005 && r.year <= 2007);
const late = rows.filter((r) => r.year >= 2023 && r.year <= 2025);
const retailUp = Math.round((avg(late.map((r) => r.retail)) / avg(early.map((r) => r.retail)) - 1) * 100);
const genChange = Math.round((avg(late.map((r) => r.generation)) / avg(early.map((r) => r.generation)) - 1) * 100);
const gridX = avg(late.map((r) => r.grid)) / avg(early.map((r) => r.grid));
const fleetFirst = fleetPts[0], fleetLast = fleetPts.at(-1)!;
const fleetChange = Math.round(((fleetLast.fleet ?? 0) / (fleetFirst.fleet ?? 1) - 1) * 100);
const leftover = lastFull.retail - (lastFull.generation ?? 0) - (lastFull.grid ?? 0);

const groups = mixGroups(d);
const src = d.sources;
const fmt = (v: number | null, digits = 2) => (v === null ? "–" : v.toFixed(digits));
---
<figure class="gap" aria-labelledby="gap-title">
  <figcaption>
    <h2 id="gap-title">Prices have risen faster than the cost of making power</h2>
    <p class="muted">What Virginia homes pay per kWh, compared with what electricity costs on the regional wholesale market and what it costs to run Virginia's power plants. All in cents per kWh, not adjusted for inflation.</p>
  </figcaption>

  <div class="kpis">
    <div><b>+{retailUp}%</b><span>Virginia home price per kWh, 2023–25 average vs. 2005–07</span></div>
    <div><b>{genChange > 0 ? "+" : ""}{genChange}%</b><span>wholesale cost of power (energy and capacity), same years</span></div>
    <div><b>{gridX.toFixed(1)}×</b><span>regional transmission charges per kWh, same years</span></div>
    <div><b>{fleetChange > 0 ? "+" : ""}{fleetChange}%</b><span>cost to fuel and run Virginia's plants, {fleetFirst.year} to {fleetLast.year}</span></div>
  </div>

  <div class="plot" id="gapPlot">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="gap-title gap-desc">
      <desc id="gap-desc">From {y0} to {lastFull.year} the average Virginia home price rose from {fmt(rows[0].retail)} to {fmt(lastFull.retail)} cents per kWh. The wholesale cost of power in PJM went from {fmt(rows[0].generation)} to {fmt(lastFull.generation)} cents, and regional transmission charges from {fmt(rows[0].grid)} to {fmt(lastFull.grid)} cents. The cost of fuel and upkeep at Virginia power plants went from {fmt(fleetFirst.fleet)} cents in {fleetFirst.year} to {fmt(fleetLast.fleet)} cents in {fleetLast.year}.</desc>
      {partial && <rect class="band" x={x(partial.year - 0.5)} y={M.t} width={x(partial.year) - x(partial.year - 0.5) + 6} height={H - M.t - M.b} />}
      <g class="grid">
        {yt.map((v) => (<g><line x1={M.l} x2={W - M.r} y1={y(v)} y2={y(v)} /><text x={M.l - 8} y={y(v) + 4} text-anchor="end">{v}¢</text></g>))}
        {xt.map((v) => <text x={x(v)} y={H - 10} text-anchor="middle">{v}</text>)}
      </g>
      {runs.map((run) => <path class="a-grid" d={area(run, gen, grid)} />)}
      {runs.map((run) => <path class="a-gen" d={area(run, () => 0, gen)} />)}
      <text class="gaplbl" x={x(2014)} y={y(1.2)} text-anchor="middle">2014</text>
      <text class="gaplbl" x={x(2014)} y={y(0.4)} text-anchor="middle">left out</text>
      <path class="ln halo" d={fleetPath} />
      <path class="ln fleet" d={fleetPath} />
      {fleetPts.map((r) => <circle class="fdot" cx={x(r.year)} cy={y(r.fleet!)} r="3.5" />)}
      <path class="ln retail" d={retailPath} />
      <text class="dl" x={x(y1) + 10} y={y(rows.at(-1)!.retail) + 4}>Virginia home price</text>
      <text class="dl" x={x(y1) + 10} y={y(grid(rows.at(-1)!)) - 2}>Transmission</text>
      <text class="dl sub" x={x(y1) + 10} y={y(grid(rows.at(-1)!)) + 12}>and grid fees</text>
      <text class="dl" x={x(y1) + 10} y={y(gen(rows.at(-1)!) * 0.7) + 4}>Wholesale power</text>
      <line class="leader" x1={x(fleetLast.year) + 6} y1={y(fleetLast.fleet!)} x2={x(y1) + 6} y2={y(fleetLast.fleet!)} />
      <text class="dl" x={x(y1) + 10} y={y(fleetLast.fleet!) + 4}>Virginia plants'</text>
      <text class="dl sub" x={x(y1) + 10} y={y(fleetLast.fleet!) + 18}>fuel and upkeep</text>
      {partial && <text class="note" x={x(partial.year)} y={M.t + 12} text-anchor="end">partial year</text>}
      <line class="cross" id="gapCross" y1={M.t} y2={H - M.b} x1="0" x2="0" />
      <g id="gapHits">
        {rows.map((r, i) => {
          const cx = x(r.year), prev = i ? x(rows[i - 1].year) : M.l, next = i < rows.length - 1 ? x(rows[i + 1].year) : W - M.r;
          return <rect x={(prev + cx) / 2} width={Math.max(1, (next - prev) / 2)} y={M.t} height={H - M.t - M.b} fill="transparent"
            data-x={cx} data-year={r.year} data-retail={fmt(r.retail)} data-gen={fmt(r.generation)} data-grid={fmt(r.grid)} data-fleet={fmt(r.fleet)} data-partial={r.partial ? "1" : ""} />;
        })}
      </g>
    </svg>
    <div class="tip" id="gapTip" hidden></div>
  </div>

  <div class="keys">
    <span><i class="sw retail"></i>Virginia home price (EIA)</span>
    <span><i class="blk gen"></i>Wholesale power: energy and capacity (PJM average)</span>
    <span><i class="blk grid"></i>Regional transmission and grid fees (PJM average)</span>
    <span><i class="sw fleet"></i>Fuel and upkeep at Virginia power plants</span>
  </div>

  <div class="prose explain">
    <p>
      In {lastFull.year}, Virginia homes paid {fmt(lastFull.retail)}¢ per kWh on average. Power itself cost about {fmt(lastFull.generation)}¢ on the
      regional wholesale market and regional transmission about {fmt(lastFull.grid)}¢. The remaining {leftover.toFixed(1)}¢ pays for local power lines and
      poles, the utility's own costs above market prices (such as paying off plants it built), state-mandated programs and riders, power lost on the
      lines, taxes and the utility's profit.
    </p>
  </div>

  <h3 class="mix-title" id="mix-title">Where Virginia's in-state power comes from</h3>
  <p class="muted small">Share of electricity made in Virginia, by source. Virginia also buys a large share of its power from the rest of PJM.</p>
  <div class="mix" role="img" aria-labelledby="mix-title mix-desc">
    <p id="mix-desc" class="sr">{groups.rows.map((r) => `${r.year}: ${groups.keys.map((k) => `${k.label} ${r.values[k.id]}%`).join(", ")}`).join(". ")}</p>
    {groups.rows.map((r) => (
      <div class="mrow">
        <span class="myr">{r.year}</span>
        <div class="mbar">
          {groups.keys.map((k) => r.values[k.id] > 0 && (
            <span class={`seg s-${k.id}`} style={`width:${r.values[k.id]}%`} title={`${r.year}, ${k.label}: ${r.values[k.id]}%`}>
              {r.values[k.id] >= 9 && <em>{Math.round(r.values[k.id])}%</em>}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="keys">
    {groups.keys.map((k) => <span><i class={`blk s-${k.id}`}></i>{k.label}</span>)}
  </div>

  <details>
    <summary>Show the numbers, sources and caveats</summary>
    <div class="scroll">
      <table class="plain">
        <thead><tr><th scope="col">Year</th><th scope="col">Virginia home price (¢/kWh)</th><th scope="col">Wholesale power (¢/kWh)</th><th scope="col">Transmission and grid fees (¢/kWh)</th><th scope="col">Virginia plants' fuel and upkeep (¢/kWh)</th></tr></thead>
        <tbody>
          {[...rows].reverse().map((r) => (
            <tr><td>{r.year}{r.partial && " (partial)"}</td><td>{fmt(r.retail)}</td><td>{fmt(r.generation)}</td><td>{fmt(r.grid)}</td><td>{fmt(r.fleet)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="scroll">
      <table class="plain">
        <thead><tr><th scope="col">Year</th>{groups.keys.map((k) => <th scope="col">{k.label} (%)</th>)}</tr></thead>
        <tbody>{groups.rows.map((r) => <tr><td>{r.year}</td>{groups.keys.map((k) => <td>{r.values[k.id].toFixed(1)}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <ul class="muted small caveats">
      <li>Wholesale figures are averages for all of PJM, the regional grid Virginia belongs to, not Dominion's area alone. They are measured where power enters local lines, before local losses.</li>
      <li>Dominion owns most of the plants that serve its customers and recovers their cost, including building them, through base rates and riders set by the SCC. The wholesale price shows what that power is worth on the market, not what Dominion actually spends.</li>
      <li>2026 covers January to September for home prices and January to October for wholesale costs.</li>
      <li>{d.wholesale.rows.find((r) => r.excluded)?.note} Source: <a href={src["mmu-2014"].url ?? undefined}>{src["mmu-2014"].name}</a>.</li>
      <li>How the Virginia plant figure is built: {d.fleet.method}</li>
      <li>{d.mix.note}</li>
    </ul>
    <p class="muted small">Sources: {Object.entries(src).filter(([k]) => k !== "mmu-2014").map(([, s], i) => <>{i > 0 && "; "}<a href={s.url ?? undefined}>{s.name}</a></>)}; home prices from the EIA sources listed with the chart above.</p>
    <p class="small"><a href="/data/v1/generation-vs-price.csv" download>Download CSV</a> · <a href="/data/v1/generation-vs-price.json">JSON</a></p>
  </details>
</figure>

<script>
  const plot = document.getElementById("gapPlot")!;
  const svg = plot.querySelector("svg")!;
  const tip = document.getElementById("gapTip")!;
  const cross = document.getElementById("gapCross")!;
  const row = (cls: string, label: string, v?: string) => {
    const s = document.createElement("span");
    const i = document.createElement("i");
    i.className = cls;
    s.append(i, `${label} ${v === "–" ? "no data" : `${v}¢`}`);
    return s;
  };
  svg.querySelectorAll<SVGRectElement>("#gapHits rect").forEach((r) => {
    r.addEventListener("pointerenter", () => {
      const { year, retail, gen, grid, fleet, partial } = r.dataset;
      const cx = Number(r.dataset.x);
      cross.setAttribute("x1", String(cx));
      cross.setAttribute("x2", String(cx));
      cross.classList.add("on");
      const b = document.createElement("b");
      b.textContent = `${year}${partial ? " (partial year)" : ""}`;
      tip.replaceChildren(b, row("sw retail", "Home price", retail), row("blk gen", "Wholesale power", gen), row("blk grid", "Transmission, grid", grid), row("sw fleet", "VA plants' fuel, upkeep", fleet));
      tip.hidden = false;
      const box = svg.getBoundingClientRect();
      tip.style.left = `${Math.min(Math.max((cx / svg.viewBox.baseVal.width) * box.width, 100), box.width - 100)}px`;
    });
  });
  svg.addEventListener("pointerleave", () => { tip.hidden = true; cross.classList.remove("on"); });
</script>

<style>
  .gap { margin: 0; }
  .gap figcaption p { margin-top: 6px; max-width: 68ch; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr)); margin: 18px 0 8px; border-top: 1px solid var(--rule); }
  .kpis > div { padding: 12px 12px 12px 0; border-bottom: 1px solid var(--rule); }
  .kpis b { display: block; font: 700 26px/1.1 var(--serif); font-variant-numeric: tabular-nums; }
  .kpis span { font-size: 13px; color: var(--muted); }
  .plot { position: relative; margin-top: 12px; }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  .grid line { stroke: var(--rule); }
  .grid text, .note, .gaplbl { fill: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .band { fill: var(--soft); }
  .a-gen { fill: var(--c4); stroke: var(--bg); stroke-width: 1; }
  .a-grid { fill: var(--c2); stroke: var(--bg); stroke-width: 1; }
  .ln { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .ln.retail { stroke: var(--ink); }
  .ln.fleet { stroke: var(--ink); stroke-dasharray: 5 4; }
  .ln.halo { stroke: var(--bg); stroke-width: 5; opacity: 0.85; }
  .leader { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 3; }
  .fdot { fill: var(--bg); stroke: var(--ink); stroke-width: 2; }
  .dl { fill: var(--ink); font-size: 13px; font-weight: 600; }
  .dl.sub { font-weight: 400; fill: var(--muted); font-size: 12px; }
  .cross { stroke: var(--muted); stroke-width: 1; opacity: 0; }
  .cross.on { opacity: 0.6; }
  .tip[hidden] { display: none; }
  .tip { position: absolute; top: 0; transform: translateX(-50%); background: var(--bg); border: 1px solid var(--rule); border-radius: 6px; padding: 6px 10px; font-size: 13px; pointer-events: none; box-shadow: 0 2px 8px rgb(0 0 0 / 0.12); display: grid; gap: 2px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .keys { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 10px; font-size: 13px; color: var(--muted); }
  :global(.gap .sw) { display: inline-block; width: 18px; height: 0; border-top: 2px solid; vertical-align: middle; margin-right: 6px; }
  :global(.gap .sw.retail) { border-color: var(--ink); }
  :global(.gap .sw.fleet) { border-color: var(--ink); border-top-style: dashed; }
  :global(.gap .blk) { display: inline-block; width: 12px; height: 12px; border-radius: 3px; vertical-align: middle; margin-right: 6px; }
  :global(.gap .blk.gen) { background: var(--c4); }
  :global(.gap .blk.grid) { background: var(--c2); }
  .explain { margin-top: 18px; max-width: 68ch; }
  .mix-title { margin-top: 32px; }
  .mix-title + p { margin-top: 4px; }
  .mix { display: grid; gap: 6px; margin-top: 12px; }
  .mrow { display: grid; grid-template-columns: 3rem 1fr; gap: 10px; align-items: center; }
  .myr { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .mbar { display: flex; height: 26px; gap: 2px; }
  .seg { display: flex; align-items: center; justify-content: center; min-width: 2px; }
  .seg:first-child { border-radius: 4px 0 0 4px; }
  .seg:last-child { border-radius: 0 4px 4px 0; }
  .seg em { font-style: normal; font-size: 12px; font-weight: 600; color: #fff; text-shadow: 0 0 2px rgb(0 0 0 / 0.5); }
  .gap { --m-coal: light-dark(#257de0, #338ced); --m-gas: light-dark(#f47230, #e76624); --m-nuclear: light-dark(#00b894, #00a888); --m-renew: light-dark(#f2a600, #d28e05); --m-other: light-dark(#ee7fac, #e24d8b); }
  :global(.gap .s-coal) { background: var(--m-coal); }
  :global(.gap .s-gas) { background: var(--m-gas); }
  :global(.gap .s-nuclear) { background: var(--m-nuclear); }
  :global(.gap .s-renew) { background: var(--m-renew); }
  :global(.gap .s-other) { background: var(--m-other); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  details { margin-top: 18px; }
  summary { cursor: pointer; color: var(--teal); }
  details > * + * { margin-top: 10px; }
  .caveats { padding-left: 1.2em; display: grid; gap: 6px; }
  .small { font-size: 13px; }
  @media (forced-colors: active) { .a-gen, .a-grid, .seg { forced-color-adjust: none; } }
</style>

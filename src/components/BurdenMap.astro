---
import data from "../data/va_burden.json";
import { GROUPS, pct, usd, num, rows, type BurdenData } from "../lib/burden.ts";

// Rendered at build time for the default view, so the table and figures work without JavaScript.
const d = data as unknown as BurdenData;
const initial = rows(d, "lt200").sort((a, b) => (b.burden ?? -1) - (a.burden ?? -1));
const s = d.state;
---
<div class="kpis" id="kpis">
  <div class="kpi"><b>{pct(s.all.burden)}</b><span>average burden, all Virginia households</span></div>
  <div class="kpi"><b>{pct(s.lt200.burden)}</b><span>average burden, households below 200% of the poverty line</span></div>
  <div class="kpi"><b>{num(Math.round(s.all.high_burden_households / 1000) * 1000)}</b><span>households estimated above 6%</span></div>
  <div class="kpi"><b>{usd(s.lt200.energy_cost)}</b><span>average yearly energy cost, households below 200% FPL</span></div>
</div>

<div class="controls">
  <div>
    <span class="lbl">Households</span>
    <div class="seg" id="groupSeg" role="group" aria-label="Income group">
      {GROUPS.map(([k, l]) => <button type="button" data-k={k} aria-pressed={k === "lt200" ? "true" : "false"}>{l}</button>)}
    </div>
  </div>
  <div>
    <span class="lbl">Measure</span>
    <div class="seg" id="metricSeg" role="group" aria-label="Measure">
      <button type="button" data-k="burden" aria-pressed="true">Average burden</button>
      <button type="button" data-k="high_burden_share" aria-pressed="false">Share above 6%</button>
    </div>
  </div>
  <div>
    <label class="lbl" for="search">Find a county or city</label>
    <input id="search" list="locs" placeholder="e.g. Henrico County" autocomplete="off" />
    <datalist id="locs">{d.features.map((f) => <option value={f.properties.name} />)}</datalist>
  </div>
</div>

<div class="plate">
  <div>
    <div class="fig" id="fig"><svg id="map" role="img" aria-label="Map of Virginia counties and cities shaded by energy burden"></svg></div>
    <div class="legend" id="legend"></div>
  </div>
  <aside class="detail" id="detail" aria-live="polite">
    <p class="muted">Select a county or city on the map or in the table.</p>
  </aside>
</div>

<section class="ranked">
  <div class="ranked-head">
    <h2 id="tableTitle">Below 200% FPL, all {initial.length} localities</h2>
    <a href="/data/va-burden-localities.csv" download>Download all figures (CSV)</a>
  </div>
  <div class="scroll">
    <table id="table">
      <thead><tr>
        <th scope="col"><button type="button" data-k="name">Locality</button></th>
        <th scope="col"><button type="button" data-k="burden">Avg. burden</button></th>
        <th scope="col"><button type="button" data-k="high_burden_share">Share above 6%</button></th>
        <th scope="col"><button type="button" data-k="high_burden_households">Households above 6%</button></th>
        <th scope="col"><button type="button" data-k="energy_cost">Energy cost / yr</button></th>
        <th scope="col"><button type="button" data-k="income">Income / yr</button></th>
      </tr></thead>
      <tbody>
        {initial.map((r) => (
          <tr data-fip={r.fip}>
            <td>{r.name}</td><td>{pct(r.burden)}</td><td>{pct(r.high_burden_share, 0)}</td>
            <td>{num(r.high_burden_households)}</td><td>{usd(r.energy_cost)}</td><td>{usd(r.income)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); margin-top: 28px; border-top: 1px solid var(--rule); }
  .kpis :global(.kpi) { padding: 16px 16px 16px 0; border-bottom: 1px solid var(--rule); }
  .kpis :global(.kpi b) { display: block; font: 700 clamp(26px, 3vw, 34px)/1.1 var(--serif); font-variant-numeric: tabular-nums; }
  .kpis :global(.kpi span) { font-size: 14px; color: var(--muted); }
  .controls { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: end; margin: 28px 0 12px; }
  .lbl { display: block; font-size: 13px; color: var(--muted); margin-bottom: 4px; }
  .seg { display: flex; flex-wrap: wrap; gap: 4px; border: 1px solid var(--rule); border-radius: 8px; padding: 3px; }
  .seg button { font: 500 14px var(--sans); color: var(--ink); background: none; border: 0; border-radius: 6px; padding: 10px 12px; min-height: 44px; cursor: pointer; }
  .seg button[aria-pressed="true"] { background: var(--teal); color: var(--bg); }
  input { font: 16px var(--sans); color: var(--ink); background: var(--bg); border: 1px solid var(--rule); border-radius: 8px; padding: 10px 12px; min-height: 44px; width: min(260px, 100%); }
  .plate { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .fig { position: relative; min-height: 340px; aspect-ratio: 2.1/1; }
  .fig > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fig :global(path.loc) { stroke: var(--line); stroke-width: 0.6; cursor: pointer; transition: opacity 0.15s; }
  .fig :global(path.loc.sel) { stroke: var(--ink); stroke-width: 2; }
  .legend { display: flex; flex-wrap: wrap; margin-top: 10px; font-size: 13px; color: var(--muted); }
  .legend :global(div) { flex: 1 1 60px; }
  .legend :global(i) { display: block; height: 10px; }
  .legend :global(small) { display: block; font-variant-numeric: tabular-nums; padding-top: 3px; }
  .detail { border-top: 2px solid var(--ink); padding-top: 12px; }
  .detail :global(h2) { margin-bottom: 4px; }
  .detail :global(.sub) { color: var(--muted); font-size: 14px; margin-bottom: 12px; }
  .detail :global(dl) { margin: 0; display: grid; grid-template-columns: 1fr auto; }
  .detail :global(dt), .detail :global(dd) { padding: 8px 0; border-bottom: 1px solid var(--rule); margin: 0; }
  .detail :global(dd) { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 500; }
  .detail :global(.utils) { margin-top: 12px; font-size: 14px; color: var(--muted); }
  .detail :global(.bars) { margin-top: 16px; font-size: 13px; }
  .detail :global(.bars div) { display: grid; grid-template-columns: 9.5em 1fr 3.5em; gap: 8px; align-items: center; margin: 6px 0; }
  .detail :global(.bars span.b) { height: 10px; background: var(--teal); border-radius: 2px; }
  .detail :global(.bars em) { font-style: normal; text-align: right; font-variant-numeric: tabular-nums; }
  .ranked { margin-top: 48px; }
  .ranked-head { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; justify-content: space-between; }
  table { border-collapse: collapse; width: 100%; font-size: 15px; margin-top: 14px; }
  th, td { padding: 9px 10px; border-bottom: 1px solid var(--rule); text-align: right; white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  th button { font: 600 13px var(--sans); color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer; }
  th[aria-sort] button { color: var(--ink); }
  td { font-variant-numeric: tabular-nums; }
  tbody tr { cursor: pointer; }
  tr.hit td { background: var(--soft); }
  @media (max-width: 820px) { .plate { grid-template-columns: 1fr; } .fig { aspect-ratio: 1.5/1; min-height: 240px; } }
  @media (prefers-reduced-motion: reduce) { .fig :global(path.loc) { transition: none; } }
</style>

<script>
  import { select } from "d3-selection";
  import { geoConicConformal, geoPath } from "d3-geo";
  import { ascending, bisectRight, quantile } from "d3-array";
  import { GROUPS, groupLabel, pct, usd, num, rows, type BurdenData, type GroupKey, type LocalityProps } from "../lib/burden.ts";
  import { utilityFromEia } from "../data/utilities.ts";

  type Metric = "burden" | "high_burden_share";
  const esc = (s: unknown) =>
    String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  let data: BurdenData;
  let group: GroupKey = "lt200";
  let metric: Metric = "burden";
  let selected = "51087"; // Henrico County
  let sortKey = "burden";
  let sortDir = -1;
  try {
    const h = location.hash.slice(1);
    if (GROUPS.some((g) => g[0] === h)) group = h as GroupKey;
  } catch {}

  const fig = $("fig");
  const svg = select<SVGSVGElement, unknown>("#map");
  const val = (p: LocalityProps) => p[group]?.[metric] ?? null;
  const cur = () => data.features.find((f) => f.properties.fip === selected)!.properties;

  function seg(id: string, get: () => string, set: (k: string) => void) {
    const el = $(id);
    const sync = () => el.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.k === get())));
    sync();
    el.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("button");
      if (!b) return;
      set(b.dataset.k!);
      sync();
      render();
    });
  }

  function scale() {
    const v = data.features.map((f) => val(f.properties)).filter((x): x is number => x != null).sort(ascending);
    const t = [0.2, 0.4, 0.6, 0.8].map((q) => quantile(v, q)!);
    return { t, c: (x: number | null) => (x == null ? "var(--soft)" : `var(--c${bisectRight(t, x)})`), min: v[0]!, max: v[v.length - 1]! };
  }

  function drawMap() {
    const W = fig.clientWidth, H = fig.clientHeight;
    if (!W || !H) return;
    const proj = geoConicConformal().parallels([37, 39.5]).rotate([79, 0]).fitExtent([[6, 6], [W - 6, H - 6]], data as any);
    const path = geoPath(proj);
    const sc = scale();
    const fmt = (v: number | null) => (metric === "burden" ? pct(v) : pct(v, 0));
    svg
      .attr("viewBox", `0 0 ${W} ${H}`)
      .selectAll<SVGPathElement, BurdenData["features"][number]>("path.loc")
      .data(data.features, (d) => d.properties.fip)
      .join((en) =>
        en
          .append("path")
          .attr("class", "loc")
          .attr("tabindex", 0)
          .on("click", (_e, d) => { selected = d.properties.fip; render(); })
          .on("keydown", (e: KeyboardEvent, d) => {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); selected = d.properties.fip; render(); }
          })
          .on("mouseenter", (_e, d) => { if (matchMedia("(hover:hover)").matches) detail(d.properties); })
          .on("mouseleave", () => detail(cur()))
          .call((p) => p.append("title")),
      )
      .attr("d", (d) => path(d as any))
      .attr("fill", (d) => sc.c(val(d.properties)))
      .classed("sel", (d) => d.properties.fip === selected)
      .each(function (d) {
        this.querySelector("title")!.textContent = `${d.properties.name}: ${fmt(val(d.properties))}`;
      });
    svg.selectAll<SVGPathElement, unknown>("path.sel").raise();
    const edges = [sc.min, ...sc.t, sc.max];
    $("legend").innerHTML = [0, 1, 2, 3, 4]
      .map((i) => `<div><i style="background:var(--c${i})"></i><small>${fmt(edges[i]!)}–${fmt(edges[i + 1]!)}</small></div>`)
      .join("");
  }

  function detail(p: LocalityProps) {
    const s = p[group];
    const utils = p.utilities.map((u) => esc(utilityFromEia(u))).join(", ");
    const bars = GROUPS.map(([k, l]) => {
      const v = p[k]?.burden;
      return `<div><span>${l}</span><span class="b" style="width:${Math.min(100, ((v || 0) / 0.4) * 100)}%"></span><em>${pct(v)}</em></div>`;
    }).join("");
    $("detail").innerHTML = `<h2>${esc(p.name)}</h2><p class="sub">${esc(groupLabel(group))}</p>
      <dl><dt>Average energy burden</dt><dd>${pct(s?.burden)}</dd>
      <dt>Households above 6%</dt><dd>${num(s?.high_burden_households)} (${pct(s?.high_burden_share, 0)})</dd>
      <dt>Households in group</dt><dd>${num(s?.households)}</dd>
      <dt>Avg. energy cost / year</dt><dd>${usd(s?.energy_cost)}</dd>
      <dt>…of which electricity</dt><dd>${usd(s?.elec_cost)}</dd>
      <dt>Avg. household income / year</dt><dd>${usd(s?.income)}</dd></dl>
      <div class="bars"><p class="muted" style="margin-bottom:4px">Average burden by income group</p>${bars}</div>
      <p class="utils">Electric utilities: ${utils || "—"}</p>`;
  }

  function kpis() {
    const s = data.state[group], a = data.state.all, l = data.state.lt200;
    const who = group === "all" ? "all households" : "households " + groupLabel(group).replace("Below", "below").replace("Above", "above");
    $("kpis").innerHTML = [
      [pct(a.burden), "average burden, all Virginia households"],
      [pct(l.burden), "average burden, households below 200% of the poverty line"],
      [num(Math.round(a.high_burden_households / 1000) * 1000), "households estimated above 6%"],
      [usd(s.energy_cost), "average yearly energy cost, " + who],
    ].map(([b, t]) => `<div class="kpi"><b>${b}</b><span>${esc(t)}</span></div>`).join("");
  }

  function table() {
    const rs = rows(data, group) as (ReturnType<typeof rows>[number] & Record<string, any>)[];
    rs.sort((a, b) =>
      sortKey === "name" ? sortDir * a.name.localeCompare(b.name) : sortDir * ((a[sortKey] ?? -1) - (b[sortKey] ?? -1)),
    );
    $("tableTitle").textContent = `${groupLabel(group)}, all ${rs.length} localities`;
    document.querySelectorAll<HTMLElement>("#table th").forEach((th) => {
      const k = th.querySelector("button")!.dataset.k;
      if (k === sortKey) th.setAttribute("aria-sort", sortDir === 1 ? "ascending" : "descending");
      else th.removeAttribute("aria-sort");
    });
    document.querySelector("#table tbody")!.innerHTML = rs
      .map((r) => `<tr class="${r.fip === selected ? "hit" : ""}" data-fip="${r.fip}"><td>${esc(r.name)}</td><td>${pct(r.burden)}</td><td>${pct(r.high_burden_share, 0)}</td><td>${num(r.high_burden_households)}</td><td>${usd(r.energy_cost)}</td><td>${usd(r.income)}</td></tr>`)
      .join("");
  }

  function render() {
    drawMap();
    detail(cur());
    kpis();
    table();
    try { history.replaceState(null, "", "#" + group); } catch {}
  }

  fetch("/data/va-burden.json")
    .then((r) => r.json())
    .then((j: BurdenData) => {
      data = j;
      seg("groupSeg", () => group, (k) => (group = k as GroupKey));
      seg("metricSeg", () => metric, (k) => (metric = k as Metric));
      $("search").addEventListener("change", (e) => {
        const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
        const f = data.features.find((f) => f.properties.name.toLowerCase() === q) ?? data.features.find((f) => f.properties.name.toLowerCase().startsWith(q));
        if (f) { selected = f.properties.fip; render(); }
      });
      document.querySelector("#table thead")!.addEventListener("click", (e) => {
        const k = (e.target as HTMLElement).closest("button")?.dataset.k;
        if (!k) return;
        sortDir = sortKey === k ? -sortDir : k === "name" ? 1 : -1;
        sortKey = k;
        table();
      });
      document.querySelector("#table tbody")!.addEventListener("click", (e) => {
        const tr = (e.target as HTMLElement).closest("tr");
        if (!tr) return;
        selected = tr.dataset.fip!;
        render();
        fig.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion:reduce)").matches ? "auto" : "smooth", block: "center" });
      });
      new ResizeObserver(() => drawMap()).observe(fig);
      render();
    })
    .catch(() => { $("detail").textContent = "The map data didn't load. Reload the page to try again."; });
</script>
